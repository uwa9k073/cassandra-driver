@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(userver COMPONENTS core)
find_dependency(lz4)

include("${CMAKE_CURRENT_LIST_DIR}/@CASSANDRA_ROOT_PROJECT_NAME@Targets.cmake")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../../testsuite")
    set(userver-cql-driver_TESTSUITE_DIRS "${CMAKE_CURRENT_LIST_DIR}/../../testsuite")
    set(userver-cql-driver_TESTSUITE_REQUIREMENTS "${CMAKE_CURRENT_LIST_DIR}/../../testsuite/requirements-cassandra.txt")
else()
    set_and_check(userver-cql-driver_TESTSUITE_DIRS "${CMAKE_CURRENT_LIST_DIR}/@CASSANDRA_TESTSUITE_RELATIVE_DIR@")
    set_and_check(userver-cql-driver_TESTSUITE_REQUIREMENTS "${CMAKE_CURRENT_LIST_DIR}/@CASSANDRA_TESTSUITE_RELATIVE_DIR@/requirements-cassandra.txt")
endif()

heck_required_components("@CASSANDRA_ROOT_PROJECT_NAME@")
